// Prisma schema for the affiliate product discovery platform.
// Catalog, affiliate links, analytics events, and import jobs.
// Amazon/eBay payloads are stored as normalized columns, not catch-all JSON.
//
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Admin / Auth
// ---------------------------------------------------------------------------

enum AdminRole {
  ADMIN
  EDITOR
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdProducts Product[]       @relation("ProductCreatedBy")
  auditLogs       AuditLog[]
  productImports  ProductImport[]
  revenueEntries  RevenueEntry[]
  priceSyncRuns   PriceSyncRun[]

  @@map("admin_users")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String
  imageUrl    String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  seoTitle       String?
  seoDescription String?

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  products        Product[]
  analyticsEvents AnalyticsEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("categories")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Product {
  id                String        @id @default(cuid())
  /// Stable integer for short public URLs (e.g. /p/42 for Instagram).
  publicId          Int           @unique @default(autoincrement())
  slug              String        @unique
  title             String
  shortDescription  String
  longDescription   String
  brand             String
  /// Manufacturer model identifier (RadarCut product identity, not a retailer SKU).
  modelNumber       String?
  gtin              String?
  mpn               String?
  status            ProductStatus @default(DRAFT)
  isFeatured        Boolean       @default(false)
  isTrending        Boolean       @default(false)

  currency            String   @default("USD")
  displayPrice        Decimal  @db.Decimal(10, 2)
  originalPrice       Decimal? @db.Decimal(10, 2)
  discountPercentage  Decimal? @db.Decimal(5, 2)

  rating      Decimal @default(0) @db.Decimal(2, 1)
  ratingCount Int     @default(0)

  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?

  publishedAt DateTime?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  createdById String?
  createdBy   AdminUser? @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  images           ProductImage[]
  affiliateLinks   AffiliateLink[]
  productViews     ProductView[]
  affiliateClicks  AffiliateClick[]
  analyticsEvents  AnalyticsEvent[]
  imports          ProductImport[]
  revenueEntries   RevenueEntry[]
  priceSyncChanges PriceSyncChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@index([isTrending])
  @@index([createdAt])
  @@index([gtin])
  @@index([mpn])
  @@index([brand, modelNumber])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  position  Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

// ---------------------------------------------------------------------------
// Marketplace / Affiliate links
// ---------------------------------------------------------------------------

enum MarketplaceCode {
  AMAZON
  EBAY
  WALMART
  BEST_BUY
  TARGET
  OTHER
}

model Marketplace {
  id       String          @id @default(cuid())
  code     MarketplaceCode @unique
  name     String
  baseUrl  String
  logoUrl  String?
  isActive Boolean         @default(true)

  affiliateLinks  AffiliateLink[]
  affiliateClicks AffiliateClick[]
  productImports  ProductImport[]
  revenueEntries  RevenueEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("marketplaces")
}

/// Purchasable retailer offer for a canonical RadarCut product.
/// One product can have many offers (Amazon + eBay + Walmart, or multiple
/// listings from the same retailer when the external IDs differ).
model AffiliateLink {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketplaceId     String
  marketplace       Marketplace @relation(fields: [marketplaceId], references: [id], onDelete: Restrict)

  externalProductId String
  rawProductUrl      String
  affiliateUrl       String
  trackingTag        String?

  listingTitle String?
  sellerName   String?
  condition    String?
  imageUrl     String?
  metadata     Json?

  isPrimary Boolean @default(false)
  isActive  Boolean @default(true)

  lastCheckedAt          DateTime?
  lastSyncedAt           DateTime?
  lastKnownPrice         Decimal?  @db.Decimal(10, 2)
  lastKnownOriginalPrice Decimal?  @db.Decimal(10, 2)
  lastKnownPriceCurrency String?
  lastKnownAvailability  String?

  clicks           AffiliateClick[]
  analyticsEvents  AnalyticsEvent[]
  priceSyncChanges PriceSyncChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, marketplaceId, externalProductId])
  @@unique([marketplaceId, externalProductId])
  @@index([productId])
  @@index([marketplaceId])
  @@index([externalProductId])
  @@index([lastSyncedAt])
  @@map("affiliate_links")
}

// ---------------------------------------------------------------------------
// Audit trail
// ---------------------------------------------------------------------------

model AuditLog {
  id        String  @id @default(cuid())
  actorId   String?
  actor     AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  action     String
  entityType String
  entityId   String

  beforeState Json?
  afterState  Json?
  ipAddress   String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Analytics / attribution
// ---------------------------------------------------------------------------

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
}

enum AnalyticsEventType {
  PAGE_VIEW
  PRODUCT_VIEW
  CATEGORY_VIEW
  SEARCH
  SEARCH_RESULT_CLICK
  NO_SEARCH_RESULTS
  RETAILER_OFFER_VIEW
  AFFILIATE_CLICK
  OUTBOUND_CLICK
  SHARE
  /// Reserved for imported retailer conversion reports. Never synthesized.
  AFFILIATE_CONVERSION
}

enum AnalyticsDimension {
  OVERALL
  COUNTRY
  SOURCE
  CAMPAIGN
  PRODUCT
  RETAILER
  DEVICE
  SEARCH
}

model TrafficSession {
  id          String      @id @default(cuid())
  anonymousId String
  landingPath String?
  referrer    String?
  userAgent   String?
  ipHash      String?
  deviceType  DeviceType?
  country     String?     @db.Char(2)
  region      String?     @db.VarChar(64)
  city        String?     @db.VarChar(64)
  /// First-touch campaign. Never overwritten after the session starts.
  firstSource   String?
  firstMedium   String?
  firstCampaign String?
  firstContent  String?
  firstTerm     String?
  /// Last-touch campaign. Updated when new UTM params arrive.
  lastSource    String?
  lastMedium    String?
  lastCampaign  String?
  lastContent   String?
  lastTerm      String?
  startedAt   DateTime    @default(now())
  lastSeenAt  DateTime    @default(now())
  createdAt   DateTime    @default(now())

  productViews    ProductView[]
  affiliateClicks AffiliateClick[]
  utmEvents       UTMEvent[]
  analyticsEvents AnalyticsEvent[]

  @@index([anonymousId])
  @@index([startedAt])
  @@index([createdAt])
  @@index([country])
  @@map("traffic_sessions")
}

model UTMEvent {
  id          String   @id @default(cuid())
  sessionId   String
  session     TrafficSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  source      String?
  medium      String?
  campaign    String?
  term        String?
  content     String?
  landingPath String?
  referrer    String?
  createdAt   DateTime @default(now())

  @@index([sessionId])
  @@index([source])
  @@index([campaign])
  @@index([createdAt])
  @@map("utm_events")
}

model ProductView {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sessionId String?
  session   TrafficSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  path      String?
  createdAt DateTime        @default(now())

  @@index([productId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("product_views")
}

model AffiliateClick {
  id              String          @id @default(cuid())
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  affiliateLinkId String?
  affiliateLink   AffiliateLink?  @relation(fields: [affiliateLinkId], references: [id], onDelete: SetNull)
  marketplaceId   String?
  marketplace     Marketplace?    @relation(fields: [marketplaceId], references: [id], onDelete: SetNull)
  sessionId       String?
  session         TrafficSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  destinationUrl  String
  createdAt       DateTime        @default(now())

  @@index([productId])
  @@index([affiliateLinkId])
  @@index([marketplaceId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("affiliate_clicks")
}

model AnalyticsEvent {
  id     String             @id @default(cuid())
  type   AnalyticsEventType
  visitorId String
  sessionId String?
  session   TrafficSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  affiliateLinkId String?
  affiliateLink   AffiliateLink? @relation(fields: [affiliateLinkId], references: [id], onDelete: SetNull)

  path           String?
  landingPath    String?
  referrer       String?
  searchQuery    String?
  resultCount    Int?
  destinationUrl String?

  /// Last-touch UTM on this event.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?

  /// First-touch UTM copied from the session. Never overwritten.
  firstUtmSource   String?
  firstUtmMedium   String?
  firstUtmCampaign String?
  firstUtmContent  String?
  firstUtmTerm     String?

  /// Normalized last-touch source: Instagram, Google, Facebook, Direct, Other.
  sourceNormalized String?

  deviceType      DeviceType?
  browser         String?
  operatingSystem String?
  language        String?     @db.VarChar(16)
  country         String?     @db.Char(2)
  region          String?     @db.VarChar(64)
  city            String?     @db.VarChar(64)

  /// Extensible payload for future Instagram / conversion fields.
  metadata Json?

  /// Time-bucketed uniqueness key used to drop refresh / double-click inflation.
  dedupeKey String @unique

  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([visitorId, createdAt])
  @@index([sessionId])
  @@index([productId, createdAt])
  @@index([categoryId, createdAt])
  @@index([affiliateLinkId, createdAt])
  @@index([utmSource, createdAt])
  @@index([utmCampaign, createdAt])
  @@index([sourceNormalized, createdAt])
  @@index([country, createdAt])
  @@index([country, city, createdAt])
  @@index([createdAt])
  @@map("analytics_events")
}

/// Daily aggregates so raw events can be purged without losing KPI history.
model AnalyticsDailyMetric {
  id        String             @id @default(cuid())
  day       DateTime           @db.Date
  dimension AnalyticsDimension
  key       String             @default("")

  visitors            Int @default(0)
  sessions            Int @default(0)
  pageViews           Int @default(0)
  productViews        Int @default(0)
  offerViews          Int @default(0)
  affiliateClicks     Int @default(0)
  searches            Int @default(0)
  zeroResultSearches  Int @default(0)
  searchResultClicks  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([day, dimension, key])
  @@index([dimension, key, day])
  @@index([day])
  @@map("analytics_daily_metrics")
}

// ---------------------------------------------------------------------------
// Marketplace import jobs
// ---------------------------------------------------------------------------

enum ImportStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ImportSourceType {
  URL
  EXTERNAL_ID
  BULK
}

model ProductImport {
  id                String           @id @default(cuid())
  marketplaceId     String
  marketplace       Marketplace      @relation(fields: [marketplaceId], references: [id], onDelete: Restrict)
  sourceType        ImportSourceType
  externalProductId String?
  sourceUrl         String?
  status            ImportStatus     @default(PENDING)
  productId         String?
  product           Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  errorMessage      String?
  createdById       String?
  createdBy         AdminUser?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([marketplaceId])
  @@index([externalProductId])
  @@index([status])
  @@index([createdAt])
  @@map("product_imports")
}

// ---------------------------------------------------------------------------
// Manual commission / revenue imports (no network order attribution yet)
// ---------------------------------------------------------------------------

enum RevenueSource {
  MANUAL_IMPORT
  NETWORK_REPORT
}

model RevenueEntry {
  id               String        @id @default(cuid())
  marketplaceId    String?
  marketplace      Marketplace?  @relation(fields: [marketplaceId], references: [id], onDelete: SetNull)
  productId        String?
  product          Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  source           RevenueSource @default(MANUAL_IMPORT)
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("USD")
  orderCount       Int?
  reportedClicks   Int?
  occurredOn       DateTime      @db.Date
  notes            String?
  createdById      String?
  createdBy        AdminUser?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([marketplaceId])
  @@index([productId])
  @@index([occurredOn])
  @@index([createdAt])
  @@map("revenue_entries")
}

// ---------------------------------------------------------------------------
// Periodic / manual retailer price re-sync
// ---------------------------------------------------------------------------

enum PriceSyncTrigger {
  MANUAL
  CRON
}

enum PriceSyncStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// One batch job that refreshes retailer offer prices (currently eBay).
model PriceSyncRun {
  id     String          @id @default(cuid())
  status PriceSyncStatus @default(PENDING)
  trigger PriceSyncTrigger

  /// Snapshot of AffiliateLink ids to process for this run (stable cursor).
  offerIds String[]

  totalOffers     Int @default(0)
  processedOffers Int @default(0)
  changedOffers   Int @default(0)
  failedOffers    Int @default(0)
  unchangedOffers Int @default(0)

  errorMessage String?

  createdById String?
  createdBy   AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  changes PriceSyncChange[]

  @@index([status])
  @@index([createdAt])
  @@map("price_sync_runs")
}

/// Offer whose price (or availability) changed during a sync run.
model PriceSyncChange {
  id     String       @id @default(cuid())
  runId  String
  run    PriceSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  affiliateLinkId String
  affiliateLink   AffiliateLink @relation(fields: [affiliateLinkId], references: [id], onDelete: Cascade)
  productId       String
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  productTitle      String
  productSlug       String
  marketplaceCode   String
  externalProductId String

  oldPrice         Decimal? @db.Decimal(10, 2)
  newPrice         Decimal? @db.Decimal(10, 2)
  oldOriginalPrice Decimal? @db.Decimal(10, 2)
  newOriginalPrice Decimal? @db.Decimal(10, 2)
  currency         String?

  oldAvailability String?
  newAvailability String?

  createdAt DateTime @default(now())

  @@index([runId])
  @@index([productId])
  @@index([affiliateLinkId])
  @@map("price_sync_changes")
}
