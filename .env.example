# Copy this file to `.env` (local dev) and fill in real values.
# Never commit `.env` — it is already covered by .gitignore.

# --- Database --------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
# Local dev example (matches `docker compose up db` if you add one later):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/product_affiliate_platform?schema=public"

# --- Public site ------------------------------------------------------------
# Base URL used for canonical links, Open Graph metadata and the sitemap.
# Must be a full origin, no trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Admin authentication ----------------------------------------------------
# Random 256-bit secret used to sign admin session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Used only by `npm run db:seed` to create the first admin account. Not read
# at runtime by the app itself.
SEED_ADMIN_EMAIL="admin@findit.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- Reserved for upcoming phases -------------------------------------------
# Marketplace integrations (Phase 5):
# AMAZON_PA_API_ACCESS_KEY=
# AMAZON_PA_API_SECRET_KEY=
# AMAZON_PA_API_PARTNER_TAG=
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
