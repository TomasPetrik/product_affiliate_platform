# Copy this file to `.env` (local dev) and fill in real values.
# Never commit `.env` — it is already covered by .gitignore.

# --- Database --------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
# Local dev example (matches `docker compose up db` if you add one later):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/product_affiliate_platform?schema=public"

# --- Public site ------------------------------------------------------------
# Base URL used for canonical links, Open Graph metadata and the sitemap.
# Must be a full origin, no trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Admin authentication ----------------------------------------------------
# Random 256-bit secret used to sign admin session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Used only by `npm run db:seed` to create the first admin account. Not read
# at runtime by the app itself.
SEED_ADMIN_EMAIL="admin@radarcut.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- Marketplace integrations ------------------------------------------------
# eBay Browse API (Level 1 import). Leave blank to boot the public site without
# import; Admin → Products → Import from eBay will then show a configuration error.
# Create an app at https://developer.ebay.com/ and enable the Buy / Browse API.
# Keep both keysets locally and switch with EBAY_ENVIRONMENT.
EBAY_ENVIRONMENT=production
EBAY_MARKETPLACE_ID=EBAY_US

EBAY_SANDBOX_CLIENT_ID=
EBAY_SANDBOX_CLIENT_SECRET=
EBAY_SANDBOX_DEV_ID=

EBAY_PRODUCTION_CLIENT_ID=
EBAY_PRODUCTION_CLIENT_SECRET=
EBAY_PRODUCTION_DEV_ID=

# eBay Partner Network campaign ID (campid) used for itemAffiliateWebUrl.
# Optional in sandbox — import still generates a test tracking URL.
# Required for real commissions in production.
EBAY_AFFILIATE_CAMPAIGN_ID=

# Marketplace Account Deletion webhook (required to enable the Production keyset).
# Token: 32–80 chars, letters/numbers/hyphen/underscore. Endpoint must match the
# HTTPS URL entered at developer.ebay.com exactly (no trailing slash).
EBAY_NOTIFICATION_VERIFICATION_TOKEN=
EBAY_NOTIFICATION_ENDPOINT=

# Shared secret for POST /api/cron/price-sync (Bearer token). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Leave blank locally if you only use Admin → Price sync. Required on the VPS cron.
CRON_SECRET=

# Amazon Associates store ID / partner tag (e.g. yourstore-20). Same on every Amazon
# link for commissions. Per-product tracking uses a generated ascsubtag stored on
# the offer — Admin → “Generate tracking ID”.
AMAZON_ASSOCIATES_TAG=

# Days to keep raw first-party analytics events. Daily aggregates are kept after purge.
# ANALYTICS_RETENTION_DAYS=400

# Omit operator traffic from first-party analytics. Comma-separated public IPs
# and/or ISO country codes. Do not commit real IPs. Logged-in admin browsers
# are also omitted automatically.
# ANALYTICS_EXCLUDE_IPS="203.0.113.10"
# ANALYTICS_EXCLUDE_COUNTRIES=

# --- Social marketing video view sync ---------------------------------------
# Used by POST /api/cron/marketing-video-sync and Admin → Sync views.
# Leave blank to boot without sync; platform posts stay PENDING until configured.

# Meta / Facebook Login for Business — Admin → Settings → Connect Meta.
# Register Valid OAuth Redirect URI exactly:
#   {NEXT_PUBLIC_SITE_URL}/api/meta/callback
# Production: https://radarcut.com/api/meta/callback
# Create a Login Configuration in Meta → Facebook Login for Business that includes:
#   pages_show_list, pages_read_engagement, pages_read_user_content,
#   pages_manage_metadata, pages_manage_engagement, pages_messaging,
#   instagram_basic, instagram_manage_insights, instagram_manage_comments
# pages_manage_engagement depends on pages_read_user_content — both must be
# Ready for testing / Advanced Access or classic OAuth fails with Invalid Scopes.
# pages_messaging is required for private DM replies to commenters.
# META_APP_ID=
# META_APP_SECRET=
# META_LOGIN_CONFIG_ID=
# Optional preferred Facebook Page ID if the user manages multiple Pages:
# META_PAGE_ID=
# META_GRAPH_API_VERSION=v22.0
# Webhook verify token (same value in Meta App Dashboard → Webhooks).
# Callback URL: {NEXT_PUBLIC_SITE_URL}/api/meta/webhooks
# Subscribe: Instagram → comments ; Page → feed
# META_WEBHOOK_VERIFY_TOKEN=
# Deprecated emergency fallback (Page access token; prefer OAuth):
# META_ACCESS_TOKEN=

# YouTube Data API v3 key (public statistics for videos you own / public videos).
# YOUTUBE_API_KEY=

# TikTok Login Kit (web) — Admin → Settings → Connect TikTok.
# Register Redirect URI exactly: {NEXT_PUBLIC_SITE_URL}/api/tiktok/callback
# Production: https://radarcut.com/api/tiktok/callback
# Scopes: user.info.basic,video.list
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# Deprecated emergency fallback (prefer OAuth):
# TIKTOK_ACCESS_TOKEN=

# TikTok Marketing API (Ads) — Admin → Settings → Connect TikTok Ads.
# Register Advertiser redirect URL exactly (trailing slash required):
#   {NEXT_PUBLIC_SITE_URL}/api/tiktok/oauth/callback/
# Production: https://radarcut.com/api/tiktok/oauth/callback/
#
# Same App ID / Secret also power TikTok account holder OAuth (comments / DMs).
# Register TikTok account holder redirect URL exactly (trailing slash required):
#   {NEXT_PUBLIC_SITE_URL}/api/tiktok/account/callback/
# Production: https://radarcut.com/api/tiktok/account/callback/
# TIKTOK_ADS_APP_ID=
# TIKTOK_ADS_APP_SECRET=
# Optional: paste the portal-generated "TikTok account holder authorization URL":
# TIKTOK_ACCOUNT_AUTHORIZATION_URL=

# WaveSpeedAI — Admin → Tools → Wan image edit (alibaba/wan-2.7/image-edit-pro).
# Create a key at https://wavespeed.ai/ (Settings → API Keys).
# WAVESPEED_API_KEY=

# Reserved for later PA-API import:
# AMAZON_PA_API_ACCESS_KEY=
# AMAZON_PA_API_SECRET_KEY=
# AMAZON_PA_API_PARTNER_TAG=
