// Prisma schema for the affiliate product discovery platform.
// Catalog, affiliate links, analytics events, and import jobs.
// Amazon/eBay payloads are stored as normalized columns, not catch-all JSON.
//
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Admin / Auth
// ---------------------------------------------------------------------------

enum AdminRole {
  ADMIN
  EDITOR
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdProducts Product[]       @relation("ProductCreatedBy")
  auditLogs       AuditLog[]
  productImports  ProductImport[]
  revenueEntries  RevenueEntry[]

  @@map("admin_users")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String
  imageUrl    String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  seoTitle       String?
  seoDescription String?

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  products        Product[]
  analyticsEvents AnalyticsEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("categories")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Product {
  id                String        @id @default(cuid())
  slug              String        @unique
  title             String
  shortDescription  String
  longDescription   String
  brand             String
  status            ProductStatus @default(DRAFT)
  isFeatured        Boolean       @default(false)
  isTrending        Boolean       @default(false)

  currency            String   @default("USD")
  displayPrice        Decimal  @db.Decimal(10, 2)
  originalPrice       Decimal? @db.Decimal(10, 2)
  discountPercentage  Decimal? @db.Decimal(5, 2)

  rating      Decimal @default(0) @db.Decimal(2, 1)
  ratingCount Int     @default(0)

  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?

  publishedAt DateTime?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  createdById String?
  createdBy   AdminUser? @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  images           ProductImage[]
  affiliateLinks   AffiliateLink[]
  productViews     ProductView[]
  affiliateClicks  AffiliateClick[]
  analyticsEvents  AnalyticsEvent[]
  imports          ProductImport[]
  revenueEntries   RevenueEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@index([isTrending])
  @@index([createdAt])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  position  Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

// ---------------------------------------------------------------------------
// Marketplace / Affiliate links
// ---------------------------------------------------------------------------

enum MarketplaceCode {
  AMAZON
  EBAY
}

model Marketplace {
  id       String          @id @default(cuid())
  code     MarketplaceCode @unique
  name     String
  baseUrl  String
  logoUrl  String?
  isActive Boolean         @default(true)

  affiliateLinks  AffiliateLink[]
  affiliateClicks AffiliateClick[]
  productImports  ProductImport[]
  revenueEntries  RevenueEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("marketplaces")
}

model AffiliateLink {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketplaceId     String
  marketplace       Marketplace @relation(fields: [marketplaceId], references: [id], onDelete: Restrict)

  externalProductId String
  rawProductUrl      String
  affiliateUrl       String
  trackingTag        String?

  isPrimary Boolean @default(false)
  isActive  Boolean @default(true)

  lastCheckedAt          DateTime?
  lastKnownPrice         Decimal?  @db.Decimal(10, 2)
  lastKnownPriceCurrency String?
  lastKnownAvailability  String?

  clicks          AffiliateClick[]
  analyticsEvents AnalyticsEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, marketplaceId])
  @@index([productId])
  @@index([marketplaceId])
  @@index([externalProductId])
  @@map("affiliate_links")
}

// ---------------------------------------------------------------------------
// Audit trail
// ---------------------------------------------------------------------------

model AuditLog {
  id        String  @id @default(cuid())
  actorId   String?
  actor     AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  action     String
  entityType String
  entityId   String

  beforeState Json?
  afterState  Json?
  ipAddress   String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Analytics / attribution
// ---------------------------------------------------------------------------

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
}

enum AnalyticsEventType {
  PAGE_VIEW
  PRODUCT_VIEW
  CATEGORY_VIEW
  SEARCH
  AFFILIATE_CLICK
  OUTBOUND_CLICK
}

model TrafficSession {
  id          String      @id @default(cuid())
  anonymousId String
  landingPath String?
  referrer    String?
  userAgent   String?
  ipHash      String?
  deviceType  DeviceType?
  country     String?     @db.Char(2)
  startedAt   DateTime    @default(now())
  lastSeenAt  DateTime    @default(now())
  createdAt   DateTime    @default(now())

  productViews    ProductView[]
  affiliateClicks AffiliateClick[]
  utmEvents       UTMEvent[]
  analyticsEvents AnalyticsEvent[]

  @@index([anonymousId])
  @@index([startedAt])
  @@index([createdAt])
  @@map("traffic_sessions")
}

model UTMEvent {
  id          String   @id @default(cuid())
  sessionId   String
  session     TrafficSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  source      String?
  medium      String?
  campaign    String?
  term        String?
  content     String?
  landingPath String?
  referrer    String?
  createdAt   DateTime @default(now())

  @@index([sessionId])
  @@index([source])
  @@index([campaign])
  @@index([createdAt])
  @@map("utm_events")
}

model ProductView {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sessionId String?
  session   TrafficSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  path      String?
  createdAt DateTime        @default(now())

  @@index([productId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("product_views")
}

model AffiliateClick {
  id              String          @id @default(cuid())
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  affiliateLinkId String?
  affiliateLink   AffiliateLink?  @relation(fields: [affiliateLinkId], references: [id], onDelete: SetNull)
  marketplaceId   String?
  marketplace     Marketplace?    @relation(fields: [marketplaceId], references: [id], onDelete: SetNull)
  sessionId       String?
  session         TrafficSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  destinationUrl  String
  createdAt       DateTime        @default(now())

  @@index([productId])
  @@index([affiliateLinkId])
  @@index([marketplaceId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("affiliate_clicks")
}

model AnalyticsEvent {
  id     String             @id @default(cuid())
  type   AnalyticsEventType
  visitorId String
  sessionId String?
  session   TrafficSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  affiliateLinkId String?
  affiliateLink   AffiliateLink? @relation(fields: [affiliateLinkId], references: [id], onDelete: SetNull)

  path           String?
  landingPath    String?
  referrer       String?
  searchQuery    String?
  destinationUrl String?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?

  deviceType DeviceType?
  country    String?     @db.Char(2)

  /// Time-bucketed uniqueness key used to drop refresh / double-click inflation.
  dedupeKey String @unique

  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([visitorId, createdAt])
  @@index([sessionId])
  @@index([productId, createdAt])
  @@index([categoryId, createdAt])
  @@index([utmSource, createdAt])
  @@index([utmCampaign, createdAt])
  @@index([createdAt])
  @@map("analytics_events")
}

// ---------------------------------------------------------------------------
// Marketplace import jobs
// ---------------------------------------------------------------------------

enum ImportStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ImportSourceType {
  URL
  EXTERNAL_ID
  BULK
}

model ProductImport {
  id                String           @id @default(cuid())
  marketplaceId     String
  marketplace       Marketplace      @relation(fields: [marketplaceId], references: [id], onDelete: Restrict)
  sourceType        ImportSourceType
  externalProductId String?
  sourceUrl         String?
  status            ImportStatus     @default(PENDING)
  productId         String?
  product           Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  errorMessage      String?
  createdById       String?
  createdBy         AdminUser?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([marketplaceId])
  @@index([externalProductId])
  @@index([status])
  @@index([createdAt])
  @@map("product_imports")
}

// ---------------------------------------------------------------------------
// Manual commission / revenue imports (no network order attribution yet)
// ---------------------------------------------------------------------------

enum RevenueSource {
  MANUAL_IMPORT
  NETWORK_REPORT
}

model RevenueEntry {
  id               String        @id @default(cuid())
  marketplaceId    String?
  marketplace      Marketplace?  @relation(fields: [marketplaceId], references: [id], onDelete: SetNull)
  productId        String?
  product          Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  source           RevenueSource @default(MANUAL_IMPORT)
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("USD")
  orderCount       Int?
  reportedClicks   Int?
  occurredOn       DateTime      @db.Date
  notes            String?
  createdById      String?
  createdBy        AdminUser?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([marketplaceId])
  @@index([productId])
  @@index([occurredOn])
  @@index([createdAt])
  @@map("revenue_entries")
}
